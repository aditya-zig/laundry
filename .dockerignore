# Allowlist the Node build inputs. Private workstation state must not even be
# transferred to a remote build daemon, regardless of the Dockerfile's COPYs.
**
!package.json
!pnpm-workspace.yaml
!pnpm-lock.yaml
!tsconfig.json
!tsconfig.base.json
!patches/
!patches/**
!packages/
!packages/**
!modules/
!modules/**
!apps/
!apps/*/
!apps/*/package.json
!apps/api/**
!apps/worker/**
!tools/
!tools/build-node.mjs
!assets/
!assets/services/
!assets/services/**

**/node_modules
**/dist
**/.env*
**/.data
**/.verification
**/*.log
**/*.pem
**/*.key
**/id_rsa*
**/__pycache__
