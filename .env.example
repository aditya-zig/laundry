# Copy to .env for local development. Values below are development-only
# placeholders. Never use them in staging or production.
API_BASE_URL=http://localhost:4100/v1
PORT=4100
DATABASE_URL=postgres://laundry:laundry_dev_only@localhost:5448/laundry
# Neon: DATABASE_URL uses the -pooler host for application traffic. Supply
# the provider's direct URL separately for migrations. Local development can
# leave this empty. Never put either private URL in EXPO_PUBLIC_* or VITE_*.
DATABASE_URL_UNPOOLED=
# Limits apply per API/worker process, not across every replica together.
PG_POOL_MAX=10
PG_CONNECTION_TIMEOUT_MS=10000
PG_IDLE_TIMEOUT_MS=30000
PG_MAX_LIFETIME_SECONDS=300
REDIS_URL=redis://localhost:6381
DEMO_MODE=true
# Frontend API origins (web previews default to localhost when unset).
EXPO_PUBLIC_API_URL=http://localhost:4100/v1
VITE_API_URL=http://localhost:4100/v1
# CORS for hosted frontends. Localhost origins are always allowed; set this to
# the exact production origin(s), comma-separated, e.g.
# CORS_ORIGIN=https://laundry-ops.vercel.app
# FRONTEND_URL is accepted as a single-origin alias.
CORS_ORIGIN=
FRONTEND_URL=
# Convex cloud deployment uses separate server environment variables set with
# `npx convex env set`. Production keeps DEMO_MODE=false. The cloud web build
# selects customer, partner, or ops with LAUNDRY_APP on each Vercel project.
CORS_ORIGINS=
ASSET_BASE_URL=
APP_ORIGIN=
# Optional cloud frontend workflow: replace both public API URLs above with
# https://<deployment>.ap-southeast-2.convex.site/v1, then pnpm dev:cloud.
# Public base URL of the API, used to build absolute asset/payment URLs.
API_ORIGIN=http://localhost:4100
# Local speech transcription (fully offline after first model download).
# Point at the repo wrapper with a portable relative path; keep the model
# cache outside the repo or under the ignored .data/ directory.
WHISPER_COMMAND=tools/voice-transcriber/whisper_wrapper.sh
WHISPER_CACHE_DIR=.data/whisper
# Optional extra argv for the wrapper as a JSON string array, e.g. '["--model","small"]'.
WHISPER_ARGV_JSON=
# Commercial providers stay UNCONFIGURED in local development. The API must
# fail explicitly (never silently simulate) when these are missing outside
# DEMO_MODE. Leave blank locally.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_BASE_URL=
WHATSAPP_API_VERSION=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Explicitly development-only demo credentials. Production uses a real OTP/SMS vendor.
DEMO_CUSTOMER_PHONE=+91-90000-00001
DEMO_RIDER_PHONE=+91-90000-00002
DEMO_OPERATOR_PHONE=+91-90000-00003
DEMO_OTP_CODE=000000
