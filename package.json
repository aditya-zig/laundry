{
  "name": "laundry",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:api": "pnpm --filter @laundry/api dev",
    "dev:customer": "pnpm --filter @laundry/customer web",
    "dev:partner": "pnpm --filter @laundry/partner web",
    "dev:ops": "pnpm --filter @laundry/ops dev",
    "check": "pnpm --filter @laundry/contracts build && tsc --noEmit -p tsconfig.json && pnpm --recursive --if-present check && pnpm --recursive --if-present typecheck",
    "test": "pnpm --recursive test",
    "test:contracts": "pnpm --filter @laundry/contracts test",
    "contracts:generate": "pnpm --filter @laundry/contracts build && node tools/contracts/openapi.mjs && python3 tools/contracts/generate-inventory.py",
    "contracts:check": "pnpm --filter @laundry/contracts build && node tools/contracts/openapi.mjs --check && node --test tools/contracts/*.test.mjs",
    "test:integration": "pnpm --filter @laundry/api test:integration",
    "build": "pnpm --recursive build",
    "test:e2e": "pnpm --filter @laundry/api test:e2e",
    "dev": "node tools/dev.mjs",
    "dev:cloud": "node tools/dev.mjs --cloud",
    "check:convex": "tsc --noEmit -p convex/tsconfig.json",
    "test:convex": "node tools/verify-convex.mjs",
    "db:start": "docker compose up -d postgres",
    "db:task": "node tools/cloud/postgres.mjs",
    "test:isolated": "node tools/cloud/postgres.mjs exec -- pnpm test",
    "test:voice": "python3 -m unittest discover -s tools/voice-transcriber/tests",
    "agents:plan": "node tools/agents/workflow.mjs planner",
    "agents:tooling": "node tools/agents/workflow.mjs tooling",
    "cloud:doctor": "node tools/agents/workflow.mjs doctor",
    "cloud:packet": "node tools/agents/workflow.mjs packet",
    "cloud:submit": "node tools/agents/workflow.mjs submit",
    "test:tooling": "pnpm --filter @laundry/contracts build && node --test tools/agents/*.test.mjs tools/verification/*.test.mjs tools/cloud/*.test.mjs tools/contracts/*.test.mjs",
    "verify:browser": "node tools/verification/run.mjs",
    "verify:pilot": "pnpm --filter @laundry/contracts build && pnpm --filter @laundry/api-client build && pnpm --filter @laundry/api build && node tools/verification/run-pilot.mjs",
    "verify:evidence": "node tools/verification/evidence.mjs",
    "platform:deploy": "node tools/cloud/deploy-platform.mjs --deploy",
    "platform:test": "node --test tools/cloud/platform.test.mjs",
    "release:security": "pnpm audit --prod --audit-level moderate",
    "platform:verify": "node tools/cloud/verify-platform-live.mjs",
    "verify:restore": "node tools/verification/restore-rehearsal.mjs",
    "verify:container": "node tools/cloud/verify-container.mjs",
    "verify:recording": "LAUNDRY_ISOLATED_RECORDING=true node tools/cloud/postgres.mjs exec --runtime docker --label hq-recording -- xvfb-run -a -s '-screen 0 1920x1080x24' node tools/verification/record-browser.mjs"
  },
  "devDependencies": {
    "@neon/config": "1.9.3",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.19.2",
    "@types/pg": "8.11.10",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "neon": "8.11.1",
    "typescript": "5.7.3",
    "vitest": "3.2.4",
    "yaml": "2.9.1"
  },
  "laundry": {
    "pinnedVersions": {
      "node": "24",
      "expo": "52.0.0",
      "expo-router": "4.0.22",
      "react": "18.3.1",
      "react-native": "0.76.5",
      "react-native-web": "0.19.13",
      "vite": "6.0.0",
      "@nestjs/common": "11.2.8",
      "pg": "8.13.0",
      "vitest": "3.2.4",
      "zod": "4.6.7"
    },
    "notes": "Customer + partner apps use Expo Router with React Native + React Native Web. Ops console uses React + Vite. API uses NestJS + pg. Versions above are the compatible set other agents must install; foundation slice pins them here via metadata so no native toolchain is required to run contract tests."
  },
  "pnpm": {
    "overrides": {
      "zod@>=4.0.0 <4.6.7": "4.6.7",
      "query-string@7.1.3>decode-uri-component": "0.5.0",
      "image-size@<2.0.3": "2.0.3",
      "tar@<7.5.22": "7.5.22",
      "qs@<6.16.1": "6.16.1",
      "postcss@>=8.0.0 <8.5.31": "8.5.31",
      "@xmldom/xmldom@<0.8.15": "0.8.15",
      "send@<0.19.0": "0.19.2",
      "body-parser@>=1.0.0 <1.20.9": "1.20.9",
      "body-parser@>=2.0.0 <2.4.0": "2.4.0",
      "undici@>=6.0.0 <6.29.1": "6.29.1",
      "path-to-regexp@>=8.0.0 <8.4.2": "8.4.2",
      "fast-uri@>=3.0.0 <3.1.9": "3.1.9",
      "multer@>=2.0.0 <2.5.0": "2.5.0",
      "uuid@>=7.0.0 <11.1.1": "11.1.1"
    },
    "patchedDependencies": {
      "metro@0.81.5": "patches/metro@0.81.5.patch",
      "query-string@7.1.3": "patches/query-string@7.1.3.patch"
    }
  },
  "dependencies": {
    "convex": "1.46.0",
    "pg": "8.13.0",
    "zod": "4.6.7"
  }
}
