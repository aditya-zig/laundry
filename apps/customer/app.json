{
  "expo": {
    "name": "Laundry Customer",
    "slug": "laundry-customer",
    "scheme": "laundry-customer",
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      ["expo-secure-store", { "configureAndroidBackup": true }],
      ["expo-sqlite", { "useSQLCipher": true }]
    ],
    "extra": {
      "apiBaseUrl": "http://localhost:4100/v1",
      "demoNote": "Development preview on port 8081. Payments and dispatch are labeled DEMO simulators."
    }
  }
}